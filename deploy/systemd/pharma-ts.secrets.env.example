# Pharma TS forecast jobs — restricted environment file (NO secrets in the unit).
#
# Install on the server:
#   sudo install -d -m 755 /etc/pharma-ts
#   sudo cp /opt/app/Forecast/deploy/systemd/pharma-ts.secrets.env.example \
#     /etc/pharma-ts/secrets.env
#   sudo chmod 600 /etc/pharma-ts/secrets.env
#   sudo chown root:root /etc/pharma-ts/secrets.env
#   # then edit /etc/pharma-ts/secrets.env
#
# Referenced by pharma-ts@.service as:
#   EnvironmentFile=-/etc/pharma-ts/secrets.env
#
# SQL login passwords stay in /opt/app/Forecast/src/.env (chmod 600), loaded by
# pkg.env — do not paste passwords here unless you intentionally set
# FORECAST_ENV_FILE to this file instead of src/.env.

# SQL connection profile for server hosts (credentials remain in src/.env).
SQL_PROFILE=server

# Optional GPU pin for A0/A1. Leave commented for CPU / default device visibility.
# CUDA_VISIBLE_DEVICES=0

# Optional: override dotenv path (default is src/.env via pkg.env).
# FORECAST_ENV_FILE=/opt/app/Forecast/src/.env
