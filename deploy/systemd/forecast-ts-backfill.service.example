# TS historical backfill systemd unit for op-minos-srv
#
# Host layout (do not use /opt/Forecast — that path does not exist here):
#   App:     /opt/app/Forecast
#   Python:  /opt/app/Forecast/.venv/bin/python
#   Secrets: /opt/app/Forecast/src/.env   (SQL_PROFILE=server)
#   State:   /opt/app/Forecast/src/data/backfill/...
#   OS user: root (no dedicated forecast account)
#
# Install / refresh on the server:
#   sudo cp /opt/app/Forecast/deploy/systemd/forecast-ts-backfill.service.example \
#     /etc/systemd/system/forecast-ts-backfill.service
#   sudo chmod +x /opt/app/Forecast/scripts/run_ts_backfill.sh
#   sudo systemctl daemon-reload
#   sudo systemctl reset-failed forecast-ts-backfill.service
#   sudo systemctl enable --now forecast-ts-backfill.service
#
# After code updates: git pull (or sync), then:
#   sudo systemctl restart forecast-ts-backfill.service

[Unit]
Description=Forecast TS MVP historical backfill (SKU x vintage)
Documentation=file:/opt/app/Forecast/docs/ts_backfill_server.md
After=network-online.target
Wants=network-online.target

# Prevent repeated restart loops after fatal failures.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple

# This host uses root (no dedicated forecast OS user).
User=root
Group=root
WorkingDirectory=/opt/app/Forecast

# Prevent numerical libraries from spawning additional CPU threads.
Environment="OMP_NUM_THREADS=1"
Environment="OPENBLAS_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
Environment="NUMEXPR_NUM_THREADS=1"

# Backfill configuration.
Environment="BACKFILL_ENGINE=v2"
Environment="BACKFILL_VINTAGES=ts_backfill_1401Q1_1405Q2"
Environment="BACKFILL_UNIVERSE=mvp_products"
Environment="BACKFILL_WORKERS=1"
# Uncomment only for a one-shot retry of FAILED jobs, then comment again:
#   sudo systemctl daemon-reload && sudo systemctl restart forecast-ts-backfill.service
# Environment="BACKFILL_EXTRA_ARGS=--retry-failed"

# SQL connection profile. Credentials stay in src/.env.
Environment="SQL_PROFILE=server"

# Pip-only server: explicit venv python (required; conda is not installed).
Environment="FORECAST_PYTHON=/opt/app/Forecast/.venv/bin/python"
# Make src/ importable even if editable install is broken/stale.
Environment="PYTHONPATH=/opt/app/Forecast/src"

ExecStart=/opt/app/Forecast/scripts/run_ts_backfill.sh

# Lower priority than production application processes.
Nice=10

# Restart after crashes/fatal orchestration failures.
# Exit 0 = complete success.
# Exit 1 = run completed but contains FAILED jobs.
SuccessExitStatus=0 1
Restart=on-failure
RestartSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=forecast-ts-backfill

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
