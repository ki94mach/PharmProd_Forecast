# Canonical env file location: src/.env
#   copy .env.example src/.env
#
# Comma-separated English product names (ProductTitleEN) that receive a zero forecast.
ZERO_FORECAST_PRODUCTS=ProductA,ProductB

# Optional production CLI defaults
# CURR_QRT=1405Q1
# FORECAST_START_DATE=140501

# =============================================================================
# SQL profiles — keep BOTH blocks; switch with SQL_PROFILE only
#   local  = this PC / domain (DistCore laptop: hostname + Windows auth)
#   server = Linux deploy (DistCore server db.yml: IP + SQL login)
# On the server you can also set Environment=SQL_PROFILE=server in systemd
# without putting passwords in the unit file.
# =============================================================================
SQL_PROFILE=local

# --- local ---
SQL_LOCAL_SERVER=
# SQL_LOCAL_PORT=1433
SQL_LOCAL_DATABASE=
SQL_LOCAL_DRIVER=ODBC Driver 17 for SQL Server
SQL_LOCAL_TRUST_SERVER_CERTIFICATE=yes
SQL_LOCAL_AUTH=windows
# SQL_LOCAL_USER=
# SQL_LOCAL_PASSWORD=

# --- server (fill password only in src/.env, never commit) ---
SQL_SERVER_SERVER=10.20.40.40
# SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=DWOrchid
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER_TRUST_SERVER_CERTIFICATE=yes
SQL_SERVER_AUTH=sql
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
