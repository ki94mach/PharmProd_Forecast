# Copy to .env in the project root (or src/) and adjust values.
# Comma-separated English product names (ProductTitleEN) that receive a zero forecast.
ZERO_FORECAST_PRODUCTS=ProductA,ProductB

# SQL Server — hostname or IP (e.g. 192.168.1.10)
SQL_SERVER=op-db1-srv
# Optional port (default SQL Server port is 1433)
# SQL_PORT=1433
# SQL_DATABASE=DWOrchid
# Windows default: SQL Server
# Linux/Fedora: ODBC Driver 18 for SQL Server (auto-selected if unset)
# SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_TRUST_SERVER_CERTIFICATE=yes
#
# Authentication: windows (Trusted_Connection) or sql (UID/PWD)
SQL_AUTH=windows
# SQL_USER=
# SQL_PASSWORD=
